+    def _generate_profile_letter(self, vacancy: dict) -> str:
+        full_vacancy = self.api_client.get(f"/vacancies/{vacancy['id']}")
+        parts = [f"Вакансия: {full_vacancy.get('name', '')}"]
+        if employer := (full_vacancy.get("employer") or {}).get("name"):
+            parts.append(f"Компания: {employer}")
+        if area := (full_vacancy.get("area") or {}).get("name"):
+            parts.append(f"Город: {area}")
+        if formats := full_vacancy.get("work_format"):
+            parts.append(
+                "Формат работы: " + ", ".join(f["name"] for f in formats if f.get("name"))
+            )
+        if experience := (full_vacancy.get("experience") or {}).get("name"):
+            parts.append(f"Требуемый опыт: {experience}")
+        if key_skills := full_vacancy.get("key_skills"):
+            parts.append(
+                "Ключевые навыки: "
+                + ", ".join(s["name"] for s in key_skills if s.get("name"))
+            )
+        if description := full_vacancy.get("description"):
+            parts.append(f"Описание:\n{strip_tags(description)}")
+        letter = self.cover_letter_ai.complete("\n".join(parts)).strip()
+        # SKIP — вакансия не по профилю, пустой ответ — сбой генерации;
+        # в обоих случаях не откликаемся
+        if not letter or letter.upper() == "SKIP":
+            return None
+        return letter
+
