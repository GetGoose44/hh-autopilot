# Скопируй в autopilot.env рядом со скриптами и заполни.
# ID резюме: hh-applicant-tool list-resumes

# Основное резюме: удалёнка + страна/город проживания
RESUME_MAIN=0000000000000000000000000000000000000000
# Регион проживания (ID из https://api.hh.ru/areas), например 146 — Сербия
HOME_AREA=146

# Второе резюме: офис/гибрид в выбранных городах, отвечает по profile_office.txt
RESUME_OFFICE=0000000000000000000000000000000000000000
# 1 — Москва, 2 — Санкт-Петербург
OFFICE_AREAS="1 2"

# Третье резюме (необязательно): переезд в Таиланд, любые подходящие роли, профиль profile_th.txt
# и правила писем letter_rules_th.txt (см. examples/). Пусто — проход выключен
RESUME_TH=

# Контакт, который бот даёт рекрутеру по просьбе
CONTACT="Telegram @your_handle"
